install.packages(c(
"CarletonStats", "devtools", "epanetReader", "fmsb", "ggplot2",
"ggthemes", "latticeExtra", "MASS", "PerformanceAnalytics",
"psych", "plyr", "prettyR", "plotrix", "proto", "RCurl",
